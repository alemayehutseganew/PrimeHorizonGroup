# Copy to .env for local development. On Vercel, set these in
# Project Settings → Environment Variables instead.
SECRET_KEY=django-insecure-local-dev-only-change-me
DEBUG=True
# Comma-separated list, e.g. https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Local SQLite is used when DATABASE_URL is empty.
# Vercel Postgres example:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
