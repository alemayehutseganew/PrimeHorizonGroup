# Prime Horizon Group — Production environment variables for Vercel
# IMPORTANT: Set these in Vercel Project Settings → Environment Variables.
# Do NOT commit real secrets to this file. The values below are placeholders.

# Database (Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
POSTGRES_URL_NON_POOLING=postgres://user:password@host:5432/dbname

# Django
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret-key
ALLOWED_HOSTS=primehorizongroup.vercel.com,www.primehorizongroup.com

# Superuser (auto-created on first build if no superuser exists)
PHG_SUPERUSER_EMAIL=admin@primehorizon.et
PHG_SUPERUSER_USERNAME=admin
PHG_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Email (configure your SMTP provider)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com

# JWT / sessions
JWT_SECRET_KEY=replace-with-jwt-secret
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
