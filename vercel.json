{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "config.wsgi:application",
      "installCommand": "pip install --break-system-packages -r requirements.txt && python -m pip install --break-system-packages --force-reinstall --no-cache-dir --no-deps psycopg2-binary",
      "buildCommand": "bash vercel-build.sh"
    },
    "frontend": {
      "root": ".",
      "framework": null,
      "outputDirectory": "website",
      "cleanUrls": true
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/static/admin/:path*",
      "destination": {
        "service": "backend",
        "path": "/staticfiles/admin/:path*"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend"
      }
    }
  ],
  "redirects": [
    {
      "source": "/static/css/:path*",
      "destination": "/css/:path*"
    },
    {
      "source": "/static/js/:path*",
      "destination": "/js/:path*"
    }
  ],
  "headers": [
    {
      "source": "/static/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/static/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ]
}
