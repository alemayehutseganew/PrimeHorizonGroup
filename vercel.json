{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "bash vercel-build.sh",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/index?__phg_path=/admin/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?__phg_path=/admin/:path*"
    },
    {
      "source": "/api",
      "destination": "/api/index?__phg_path=/api/"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__phg_path=/api/:path*"
    },
    {
      "source": "/static/admin/:path*",
      "destination": "/staticfiles/admin/:path*"
    }
  ],
  "headers": [
    {
      "source": "/static/css/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/css; charset=utf-8"
        }
      ]
    },
    {
      "source": "/static/js/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/static/css/:path*",
      "destination": "/website/css/:path*"
    },
    {
      "source": "/static/js/:path*",
      "destination": "/website/js/:path*"
    },
    {
      "source": "/images/:path*",
      "destination": "/website/images/:path*"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/about",
      "destination": "/website/about.html"
    },
    {
      "source": "/about/",
      "destination": "/website/about.html"
    },
    {
      "source": "/services",
      "destination": "/website/services.html"
    },
    {
      "source": "/services/",
      "destination": "/website/services.html"
    },
    {
      "source": "/fleet",
      "destination": "/website/fleet.html"
    },
    {
      "source": "/fleet/",
      "destination": "/website/fleet.html"
    },
    {
      "source": "/projects",
      "destination": "/website/projects.html"
    },
    {
      "source": "/projects/",
      "destination": "/website/projects.html"
    },
    {
      "source": "/careers",
      "destination": "/website/careers.html"
    },
    {
      "source": "/careers/",
      "destination": "/website/careers.html"
    },
    {
      "source": "/contact",
      "destination": "/website/contact.html"
    },
    {
      "source": "/contact/",
      "destination": "/website/contact.html"
    },
    {
      "source": "/portal",
      "destination": "/website/portal.html"
    },
    {
      "source": "/portal/",
      "destination": "/website/portal.html"
    },
    {
      "source": "/privacy",
      "destination": "/website/privacy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/website/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/website/terms.html"
    },
    {
      "source": "/terms/",
      "destination": "/website/terms.html"
    }
  ]
}
