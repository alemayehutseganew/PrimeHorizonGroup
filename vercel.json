{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "buildCommand": "pip install --break-system-packages -r requirements.txt && python manage.py migrate --noinput && python manage.py seed_demo && python manage.py collectstatic --noinput",
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "/website/images/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/website/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/website/js/:path*"
    },
    {
      "source": "/portal",
      "destination": "/website/portal.html"
    },
    {
      "source": "/about",
      "destination": "/website/about.html"
    },
    {
      "source": "/services",
      "destination": "/website/services.html"
    },
    {
      "source": "/fleet",
      "destination": "/website/fleet.html"
    },
    {
      "source": "/projects",
      "destination": "/website/projects.html"
    },
    {
      "source": "/careers",
      "destination": "/website/careers.html"
    },
    {
      "source": "/contact",
      "destination": "/website/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/website/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/website/terms.html"
    },
    {
      "source": "/:page.html",
      "destination": "/website/:page.html"
    },
    {
      "source": "/",
      "destination": "/website/index.html"
    }
  ]
}