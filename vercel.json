{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": ".",
      "entrypoint": "config.wsgi:application",
      "installCommand": "pip install --break-system-packages -r requirements.txt",
      "buildCommand": "bash vercel-build.sh"
    },
    "frontend": {
      "root": "website",
      "cleanUrls": true,
      "rewrites": [
        {
          "source": "/",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/admin/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/api/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/static/admin/:path*",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "redirects": [
    {
      "source": "/static/css/:path*",
      "destination": "/css/:path*",
      "permanent": true
    },
    {
      "source": "/static/js/:path*",
      "destination": "/js/:path*",
      "permanent": true
    }
  ]
}
